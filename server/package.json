{
  "name": "dae2uni-server",
  "private": true,
  "version": "0.1.0",
  "description": "REST API foundation for DAE2UNI Pathway",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check:models": "node scripts/validateModels.js",
    "check:catalogue": "node scripts/validateCatalogue.js",
    "check:geographic-catalogue": "node scripts/validateGeographicCatalogue.js",
    "check:security": "node scripts/validateSecurityRegression.js",
    "check:turnstile": "node scripts/validateTurnstile.js",
    "check:email-verification": "node scripts/validateEmailVerification.js",
    "check:password-recovery": "node scripts/validatePasswordRecovery.js",
    "check:setup": "node scripts/validateAdminSetup.js",
    "check:roles": "node scripts/validateRoleManagement.js",
    "check:merit-management": "node scripts/validateMeritManagement.js",
    "check:merit-calculator": "node scripts/validateMeritCalculator.js",
    "check:eligibility-research": "node scripts/validateEligibilityResearch.js",
    "check:eligibility-rules": "node scripts/validateEligibilityRuleManagement.js",
    "check:eligibility-evaluation": "node scripts/validateEligibilityEvaluation.js",
